{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    ".opencode/plugins/graphify.js",
    "superpowers@git+https://github.com/obra/superpowers.git",
    "~/.config/opencode/node_modules/ecc-universal",
    "~/.config/opencode/node_modules/andrej-karpathy-skills",
    "~/.config/opencode/node_modules/caveman",
    "~/.config/opencode/node_modules/cavekit",
    "~/.config/opencode/node_modules/open-design",
    "~/.config/opencode/node_modules/ruflo",
    "~/.config/opencode/node_modules/tweakcc",
    "~/.config/opencode/node_modules/mcp-servers",
    "~/.config/opencode/node_modules/supabase-mcp",
    "~/.config/opencode/node_modules/playwright-mcp",
    "~/.config/opencode/node_modules/lighthouse-mcp",
    "~/.config/opencode/node_modules/fetcher-mcp",
    "~/.config/opencode/plugins/claude-mem.js"
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": true
    }
  },
  "formatter": true,
  "lsp": true,
  "permission": {
    "edit": {
      ".env*": "ask"
    },
    "bash": {
      "npm install": "ask",
      "npm run build": "ask",
      "npm run dev": "ask"
    }
  },
  "watcher": {
    "ignore": ["dist/**", "node_modules/**"]
  },
  "command": {
    "lint": {
      "template": "npm run lint",
      "description": "TypeScript type-check"
    },
    "dev": {
      "template": "npm run dev",
      "description": "Start dev server on :3000"
    },
    "rebuild": {
      "template": "npm run clean && npm run build",
      "description": "Clean + production build"
    }
  }
}
